    "settings.automaticRefresh.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo plant die Aktualisierung systemfreundlich. macOS entscheidet den genauen Zeitpunkt; vollständig beendete Apps werden dafür nicht neu gestartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo schedules refreshes in a system-friendly way. macOS decides the exact time; fully quit apps are not relaunched for this."
          }
        },
        "fr" : {
