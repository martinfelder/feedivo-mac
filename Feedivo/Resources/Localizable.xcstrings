    "database.init.error.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Feeds sind vorerst nicht verfügbar. Die App läuft mit einer leeren, temporären Datenbank. Bitte starte die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved feeds are temporarily unavailable. The app is running with an empty, temporary database. Please restart the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos flux enregistrés sont temporairement indisponibles. L'application fonctionne avec une base de données temporaire vide. Veuillez redémarrer l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi feed salvati sono temporaneamente non disponibili. L'app viene eseguita con un database temporaneo vuoto. Riavvia l'app."
          }
        }
      }
    },
