    "settings.articleRetention.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo löscht ältere Artikel erst, wenn die Funktion aktiv ist. Artikel mit Stern oder Archivstatus bleiben geschützt, solange die Zusatzoption nicht eingeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo only deletes older articles after the feature is enabled. Starred or archived articles stay protected unless the extra option is turned on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo ne supprime les anciens articles que lorsque la fonction est activée. Les articles avec étoile ou archivés restent protégés tant que l’option supplémentaire n’est pas activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo elimina gli articoli più vecchi solo quando la funzione è attiva. Gli articoli con stella o archiviati restano protetti finché l’opzione aggiuntiva non viene attivata."
          }
        }
      }
    },
