    "settings.automaticRefresh.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo plant die Aktualisierung systemfreundlich. macOS entscheidet den genauen Zeitpunkt; vollständig beendete Apps werden dafür nicht neu gestartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo schedules refreshes in a system-friendly way. macOS decides the exact time; fully quit apps are not relaunched for this."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo planifie les actualisations de façon adaptée au système. macOS décide du moment exact; les apps complètement quittées ne sont pas relancées pour cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo pianifica gli aggiornamenti in modo rispettoso del sistema. macOS decide l'orario esatto; le app chiuse completamente non vengono riavviate per questo."
          }
        }
      }
    },
