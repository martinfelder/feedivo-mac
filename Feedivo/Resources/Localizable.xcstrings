    "settings.articleRetention.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo löscht ältere Artikel erst, wenn die Funktion aktiv ist. Artikel mit Stern oder Archivstatus bleiben geschützt, solange die Zusatzoption nicht eingeschaltet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedivo only deletes older articles after the feature is enabled. Starred or archived articles stay protected unless the extra option is turned on."
