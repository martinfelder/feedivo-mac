    "settings.offline.autoSaveStarred.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einem Artikel einen Stern gibst, legt Feedivo automatisch eine Offline-Kopie an. Beim Entfernen des Sterns bleibt die Kopie erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you star an article, Feedivo automatically creates an offline copy. Removing the star keeps the copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ajoutez une étoile à un article, Feedivo crée automatiquement une copie hors ligne. Retirer l’étoile conserve la copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi una stella a un articolo, Feedivo crea automaticamente una copia offline. Rimuovere la stella mantiene la copia."
          }
        }
      }
    },
    "settings.offline.autoSaveStarred.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel mit Stern automatisch offline speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically save starred articles offline"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer automatiquement hors ligne les articles avec étoile"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva automaticamente offline gli articoli con stella"
          }
        }
      }
    },
    "settings.offline.automation.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stern-Artikel können jetzt automatisch gespeichert werden. Weitere Regeln nach Feed, Ungelesen-Status oder Zeitraum bleiben ein späterer M4-Folgepunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starred articles can now be saved automatically. More rules by feed, unread state, or time range remain a later M4 follow-up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles avec étoile peuvent maintenant être enregistrés automatiquement. D’autres règles par flux, état non lu ou période restent prévues pour plus tard dans M4."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli articoli con stella ora possono essere salvati automaticamente. Altre regole per feed, stato non letto o periodo restano un seguito M4 successivo."
          }
        }
      }
    },
    "settings.offline.automation.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic saving"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement automatique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio automatico"
          }
        }
      }
    },
    "settings.offline.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt, was Feedivo wirklich offline speichert und was nur normal lokal verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explains what Feedivo really saves offline and what is only normally available locally."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique ce que Feedivo enregistre vraiment hors ligne et ce qui est seulement disponible localement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega cosa Feedivo salva davvero offline e cosa è solo disponibile localmente."
          }
        }
      }
    },
    "settings.offline.feedContent.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Feed Volltext liefert, speichert Feedivo diesen Artikelinhalt normal in der Datenbank. Das ist keine bewusste Offline-Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a feed provides full text, Feedivo stores that article content normally in the database. That is not an explicit offline copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un flux fournit le texte complet, Feedivo stocke normalement ce contenu dans la base de données. Ce n’est pas une copie hors ligne explicite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un feed fornisce il testo completo, Feedivo salva normalmente quel contenuto nel database. Non è una copia offline esplicita."
          }
        }
      }
    },
    "settings.offline.feedContent.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed-Inhalt ist Basisinhalt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed content is base content"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du flux est le contenu de base"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto del feed è contenuto di base"
          }
        }
      }
    },
    "settings.offline.manual.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Reader-Button Offline speichern legt eine bewusste Kopie für genau diesen Artikel an und zeigt danach einen Status am Artikel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reader button Save offline creates an explicit copy for that article and then shows article-level status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton Enregistrer hors ligne du lecteur crée une copie explicite pour cet article et affiche ensuite son état."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante Salva offline nel reader crea una copia esplicita per quell’articolo e poi mostra lo stato dell’articolo."
          }
        }
      }
    },
