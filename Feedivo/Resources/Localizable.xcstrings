    "Die ausgewählten Feeds wurden gespeichert. Hinweise zeigen dir, was noch Aufmerksamkeit braucht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Feeds wurden gespeichert. Hinweise zeigen dir, was noch Aufmerksamkeit braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected feeds have been saved. Hints show what still needs attention."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux sélectionnés ont été enregistrés. Les indications montrent ce qui requiert encore de l'attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I feed selezionati sono stati salvati. Gli avvisi mostrano cosa richiede ancora attenzione."
          }
        }
      }
    },
    "Diese Feeds werden gespeichert, wenn du fortfährst. Über „Auswahl bearbeiten“ kommst du zurück zur Liste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Feeds werden gespeichert, wenn du fortfährst. Über „Auswahl bearbeiten“ kommst du zurück zur Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These feeds will be saved when you continue. Use “Edit selection” to return to the list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces flux seront enregistrés lorsque vous continuerez. Utilisez « Modifier la sélection » pour revenir à la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi feed verranno salvati quando continui. Usa «Modifica selezione» per tornare alla lista."
          }
        }
      }
    },
    "Dieser Feed liefert aktuell keine Artikel für die Vorschau.": {},
