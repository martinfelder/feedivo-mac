    "settings.cache.description.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo lädt Bilder nur bei Bedarf und speichert sie lokal. Beim Überschreiten des Limits werden ältere Cache-Dateien entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo loads images on demand and stores them locally. Older cache files are removed when the limit is exceeded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo charge les images à la demande et les stocke localement. Les anciens fichiers de cache sont supprimés lorsque la limite est dépassée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedivo carica le immagini quando servono e le salva localmente. I file cache più vecchi vengono rimossi quando il limite viene superato."
          }
        }
      }
    },
