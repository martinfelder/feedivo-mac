    "settings.notifications.appIconBadge.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Anzahl ungelesener Artikel als Badge am Dock-Icon. Wird der Schalter deaktiviert, wird der Badge sofort ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the number of unread articles as a badge on the Dock icon. When disabled, the badge is hidden immediately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le nombre d’articles non lus comme badge sur l’icône du Dock. Si l’option est désactivée, le badge disparaît immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il numero di articoli non letti come badge sull’icona del Dock. Se disattivato, il badge viene nascosto subito."
          }
        }
      }
    },
