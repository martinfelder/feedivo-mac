    "settings.cache.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert den lokalen Bild- und Favicon-Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls local image and favicon storage."
          }
