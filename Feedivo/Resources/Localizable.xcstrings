    "settings.markReadOnOpen.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option aktiv ist, markiert Feedivo einen Artikel als gelesen, sobald du ihn in der Liste öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this option is enabled, Feedivo marks an article as read as soon as you open it from the list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, Feedivo marque un article comme lu dès que vous l'ouvrez depuis la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questa opzione è attiva, Feedivo segna un articolo come letto appena lo apri dall'elenco."
          }
        }
      }
    },
    "settings.markReadOnOpen.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel beim Öffnen als gelesen markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark articles as read when opened"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer les articles comme lus à l'ouverture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna gli articoli come letti all'apertura"
          }
        }
      }
    },
    "settings.notifications.appIconBadge.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Anzahl ungelesener Artikel als Badge am Dock-Icon. Wird der Schalter deaktiviert, wird der Badge sofort ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the number of unread articles as a badge on the Dock icon. When disabled, the badge is hidden immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le nombre d’articles non lus comme badge sur l’icône du Dock. Si l’option est désactivée, le badge disparaît immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il numero di articoli non letti come badge sull’icona del Dock. Se disattivato, il badge viene nascosto subito."
          }
        }
      }
    },
    "settings.notifications.appIconBadge.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge-Zähler am App-Icon anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show badge count on app icon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le compteur sur l’icône de l’app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il badge sull’icona dell’app"
          }
        }
      }
    },
    "settings.notifications.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert sichtbare Hinweise wie den App-Icon-Badge und bereitet Feed- und Regel-Benachrichtigungen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls visible alerts such as the app icon badge and prepares feed and rule notifications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle les indications visibles comme le badge de l’icône de l’app et prépare les notifications de flux et de règles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla gli avvisi visibili come il badge dell’icona dell’app e prepara le notifiche di feed e regole."
          }
        }
      }
    },
    "settings.notifications.feed.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed-Benachrichtigungen werden pro Feed in den Feed-Eigenschaften aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed notifications are enabled per feed in Feed Properties."
          }
